Options -Indexes
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS obrigatorio (Let's Encrypt da Hostinger)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Codigo privado: por padrao mora FORA do docroot (../anima). Quando o FTP e preso
  # ao site, ele fica em /anima e este bloco impede servir ou executar esses arquivos.
  RewriteRule ^(anima|app|db|storage|vendor)/ - [F,L,NC]

  # Midias: nada de estatico direto. Tudo passa pelo front controller, que exige
  # sessao antes de entregar a imagem (galeria privada).
  RewriteRule ^media(/|$) index.php [L,QSA]

  # Arquivos e pastas existentes sao servidos direto (assets, icones, manifest...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto vai para o front controller (SPA + API)
  RewriteRule ^ index.php [L]
</IfModule>

# Nada de arquivos sensiveis no docroot
<FilesMatch "\.(env|sql|log|ini|bak|sh|ps1|ts|map|md|json)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>
