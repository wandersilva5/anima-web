# Copie para server/.env e preencha. Nunca envie este arquivo ao servidor por FTP.
# No servidor, o .env deve ficar FORA do public_html (ex.: /home/usuario/anima/.env).

APP_ENV=local
# Producao: APP_ENV=production e APP_URL=https://femipro.trustchoicereviews.com
APP_URL=http://localhost:8080
SITE_NAME=Galeria Anima

# MariaDB / MySQL da Hostinger (hPanel > Bancos de dados)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=anima_galeria
DB_USER=anima_user
DB_PASS=

# Sessao e uploads
SESSION_TTL_DAYS=30
SYNC_MAX_BYTES=20971520

# Caminhos (deixe vazio para o padrao: server/storage e server/public/media).
# Na hospedagem com o codigo fora do docroot, aponte para os caminhos absolutos:
#   STORAGE_DIR=/home/usuario/domains/trustchoicereviews.com/anima/storage
#   MEDIA_DIR=/home/usuario/domains/trustchoicereviews.com/public_html/femipro/media
STORAGE_DIR=
MEDIA_DIR=

# URL base das midias. Vazio = detecta sozinho a partir do caminho do index.php.
# Use apenas se as imagens forem servidas por outro dominio/CDN.
MEDIA_URL=

# Definido automaticamente pelo migrate; use para rotacionar manualmente
# SYNC_TOKEN=
